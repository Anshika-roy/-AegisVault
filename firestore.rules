rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCaseClient() {
      return isSignedIn() && resource.data.clientUid == request.auth.uid;
    }

    function isCaseLawyer() {
      return isSignedIn() && resource.data.lawyerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow read: if isSignedIn() && (
        resource.data.clientUid == request.auth.uid ||
        resource.data.lawyerUid == request.auth.uid ||
        resource.data.lawyerUid == ''
      );

      allow create: if isSignedIn() &&
        request.resource.data.clientUid == request.auth.uid;

      // Client can only edit client-owned non-critical fields.
      allow update: if isCaseClient() &&
        request.resource.data.clientUid == resource.data.clientUid &&
        request.resource.data.lawyerUid == resource.data.lawyerUid &&
        request.resource.data.requestStatus == resource.data.requestStatus;

      // Lawyer can accept/decline and update legal progress when assigned.
      allow update: if isCaseLawyer();

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userUid == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userUid == request.auth.uid;
      allow delete: if false;
    }
  }
}
